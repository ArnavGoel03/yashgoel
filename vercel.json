{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/blob-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/listening/refresh",
      "schedule": "7 4 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)content/_subscribers.json' ':(exclude)content/_inbox.json' ':(exclude)content/_listening.json'"
}
